# ==============================================================================
# GEOALERT — Environment Configuration Template
# ==============================================================================

# --- BACKEND (FastAPI / Render / Railway) ---
PORT=8000
PYTHON_VERSION=3.12.8

# CORS configuration (Accepts any Vercel domain, localhost, or custom domains)
CORS_ORIGINS=*
# Optional custom regex:
# CORS_ORIGIN_REGEX=https?://.*\\.vercel\\.app|https?://.*\\.onrender\\.com|https?://localhost(:\\d+)?

# --- FRONTEND (Next.js / Vercel) ---
# For Local Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# For Vercel Production (Point to your live deployed backend):
# NEXT_PUBLIC_API_BASE_URL=https://geoalert-backend.onrender.com/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://geoalert-backend.up.railway.app/api/v1
