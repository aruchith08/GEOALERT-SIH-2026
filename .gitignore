# ==============================================================================
# GEOALERT — Smart India Hackathon (SIH 2026) .gitignore
# ==============================================================================

# Raw Multi-Gigabyte Satellite Rasters (CHIRPS & SRTM GeoTIFFs)
data/raw/

# Python & Virtualenv Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# Node / Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
frontend/build/
.npm
.eslintcache

# NEVER ignore frontend TypeScript libraries
!frontend/lib/
!frontend/lib/**

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Scratch temporary
scratch/*.tmp
